generator client {
  provider      = "prisma-client-js"
  // "native" = your own machine; rhel-openssl-3.0.x = Vercel's Linux runtime (the engine is bundled with the function)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Neon connection string (the "direct" / unpooled one)
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("CUSTOMER") // CUSTOMER | ADMIN
  isBlocked     Boolean        @default(false)
  tokenVersion  Int            @default(0)
  failedLogins  Int            @default(0)
  lockedUntil   DateTime?
  resetTokenHash String?
  resetExpires  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  addresses     Address[]
  cart          CartItem[]
  wishlist      WishlistItem[]
  reviews       Review[]
  orders        Order[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String
  price       Int // paise
  mrp         Int // paise
  stock       Int            @default(0)
  images      String         @default("[]") // JSON array of urls
  brand       String?
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  isActive    Boolean        @default(true)
  isFeatured  Boolean        @default(false)
  ratingAvg   Float          @default(0)
  ratingCount Int            @default(0)
  soldCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  reviews     Review[]
  wishlist    WishlistItem[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([isActive, createdAt])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  title     String?
  comment   String
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  productId String
  quantity  Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  status            String // PENDING_PAYMENT | PAID | PROCESSING | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  paymentMethod     String // RAZORPAY | COD
  paymentStatus     String      @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  subtotal          Int
  discount          Int         @default(0)
  shipping          Int         @default(0)
  total             Int
  couponCode        String?
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  shippingAddress   String // JSON snapshot
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]

  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  image     String?
  price     Int
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  type       String // PERCENT | FLAT
  value      Int // percent (1-100) or paise
  minOrder   Int       @default(0)
  maxDiscount Int?
  usageLimit Int?
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
