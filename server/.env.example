NODE_ENV=development
PORT=4000
# 0.0.0.0 = reachable from other devices on your network. Use 127.0.0.1 to restrict to this machine.
HOST=0.0.0.0

# ---- Neon (PostgreSQL) ----------------------------------------------------------
# The app + schema setup + seeding. In Neon turn Connection pooling OFF and copy that string
# (the host does NOT contain "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Tests wipe this database on every run. Use a SEPARATE Neon branch/database whose name contains "test".
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/shop_test?sslmode=require&connect_timeout=15"

# ---- Auth ------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars

# ---- Network / CORS --------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API (add your real domain in production).
CLIENT_ORIGIN=http://localhost:5173
# In development, origins from private LAN IPs (192.168.x.x, 10.x.x.x, 172.16-31.x.x) are accepted automatically.
# Set to 0 to disable, or 1 to force-enable.
# ALLOW_LAN_ORIGINS=1

# ---- Backblaze B2 (product images, via the S3-compatible API) ----------------------
# Create a PUBLIC bucket, then an Application Key limited to that bucket (read + write).
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# Region shown in the bucket's endpoint, e.g. us-west-004 (endpoint s3.us-west-004.backblazeb2.com)
B2_REGION=
# Optional: CDN / custom domain in front of the bucket. Defaults to https://<bucket>.s3.<region>.backblazeb2.com
B2_PUBLIC_URL=

# ---- Email via Resend (https://resend.com) -----------------------------------------
# Password-reset links, order / payment confirmations and the contact form need this.
# Without it, mail is only printed to the server log. MAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
MAIL_FROM="Shop <orders@yourdomain.com>"
# Where the contact form delivers messages
SUPPORT_EMAIL=

# ---- Shared rate limits (needed on Vercel / any multi-instance host) ------------------
# Free Redis at https://upstash.com  -> REST URL + REST token. Empty = in-memory counters (single server only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Housekeeping cron (Vercel) ----------------------------------------------------------
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/maintenance.
CRON_SECRET=

# ---- Razorpay (leave empty for MOCK payments in development only) -------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Seed ------------------------------------------------------------------------
# The app is reachable on your network: set a strong admin password BEFORE seeding.
ADMIN_EMAIL=admin@shop.test
ADMIN_PASSWORD=Admin@12345
